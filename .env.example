# VoiceOps 环境变量配置示例

# 基础环境
APP_NAME=VoiceOps
APP_ENV=development
DEBUG=True
PORT=8000

# 数据库配置 (本地使用 SQLite，Docker 部署使用 PostgreSQL+pgvector)
DATABASE_URL=sqlite+aiosqlite:///./voiceops.db
# 生产/Docker 容器环境示例:
# DATABASE_URL=postgresql+asyncpg://voiceops:voiceops_secret@postgres:5432/voiceops_db

# Redis 缓存与队列
REDIS_URL=redis://127.0.0.1:6379/0
# 生产/Docker 容器环境示例:
# REDIS_URL=redis://redis:6379/0

# 存储路径
STORAGE_DIR=./storage
AUDIO_STORAGE_DIR=./storage/audio

# ASR 模型配置
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# 大模型与 RAG 配置
LLM_PROVIDER=local_mock
LLM_MODEL_NAME=qwen2.5-7b-instruct
EMBEDDING_MODEL=text-embedding-v3-small

# n8n 自动化与邮件测试服务
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/voiceops-ticket
MAILPIT_SMTP_SERVER=127.0.0.1:1025

# 安全与密钥 (生产部署请更换为随机字符串)
SECRET_KEY=voiceops_dev_secret_key_change_in_production_2026
